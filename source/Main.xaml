                                <Ellipse Width="50" Height="19" Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform Angle="-32"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,5,0"/>
                                <Path Stroke="{DynamicResource Subtle}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
