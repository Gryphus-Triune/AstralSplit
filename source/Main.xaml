                                        <ToggleButton.ContentTemplate><DataTemplate>
                                            <app:SelectedCount Summary="{Binding}" CacheMode="{StaticResource ForegroundCache}"/>
                                        </DataTemplate></ToggleButton.ContentTemplate>
                                    </ToggleButton>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="8,0,8,8" Panel.ZIndex="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="SearchField" Grid.Column="0" Height="32" HorizontalAlignment="Stretch" CornerRadius="14"
                                Margin="0,0,8,0" Background="{DynamicResource GlassField}" BorderThickness="1" BorderBrush="{DynamicResource GlassSeam}" Cursor="IBeam">
                            <Grid Margin="8,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Path Style="{StaticResource LineIcon}" HorizontalAlignment="Left"
                                      Data="M6.5,1.75 A4.75,4.75 0 1 1 6.49,1.75 Z M10,10 L14,14"/>
                                <TextBlock x:Name="SearchHint" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Subtle}" Text="搜索应用名称或路径" TextTrimming="CharacterEllipsis" FontSize="13" IsHitTestVisible="False"/>
                                <TextBox x:Name="Search" Grid.Column="1" CacheMode="{StaticResource ForegroundCache}" Background="Transparent" Foreground="{DynamicResource Ink}"
                                         CaretBrush="{DynamicResource Ink}" SelectionBrush="{DynamicResource Accent}"
                                         BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontSize="13"
                                         AutomationProperties.Name="搜索应用" AutomationProperties.AcceleratorKey="Ctrl+F"/>
                                <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6"
                                        Padding="4,0" BorderThickness="1" BorderBrush="{DynamicResource Line}" IsHitTestVisible="False">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible, ElementName=SearchHint}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Search}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Subtle}"/>
                                </Border>
                                <Button x:Name="ClearSearch" Grid.Column="2" Width="24" Height="24" Style="{StaticResource PlainButton}"
