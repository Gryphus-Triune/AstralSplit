                                <TextBlock x:Name="DetailReason" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SkyText}" FontSize="12"/>
                                <TextBlock x:Name="TrafficDetail" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SkyBodyText}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="NetworkDot" Width="6" Height="6" Fill="{DynamicResource StatusOff}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetworkLabel" Grid.Column="1" Foreground="{DynamicResource SkyBodyText}" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Expander>
                        <Button x:Name="VpnAdapter" Grid.Row="1" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
