                        <ListBox x:Name="Applications" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource AppRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
