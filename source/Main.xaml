                                        <Ellipse Fill="{DynamicResource Subtle}" Opacity="0.8"/>
                                        <Path Stroke="{DynamicResource Recess}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M4.5,4.5 L9.5,9.5 M9.5,4.5 L4.5,9.5"/>
                                    </Grid>
                                </Button>
                            </Grid>
