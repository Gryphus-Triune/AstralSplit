                                    </Setter>
                                </Style>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="24"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="0,3">
                                                    <Track.Resources>
                                                        <!-- WPF reserves half this height for the minimum thumb when it sizes the drag range. -->
                                                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">68</sys:Double>
                                                    </Track.Resources>
                                                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                                                    <!-- Keep the moving thumb above the page buttons so its painted position is also grabbable. -->
                                                    <Track.Thumb>
                                                        <app:LiquidScrollThumb Background="{DynamicResource ScrollGrip}">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type app:LiquidScrollThumb}">
                                                                    <Border x:Name="GripField">
                                                                        <Grid Background="Transparent">
                                                                            <app:CapsuleThumb x:Name="Grip" RestFill="{TemplateBinding Background}"
                                                                                Tint="{DynamicResource ScrollGripPressed}" Strength="1.12" Pressed="{TemplateBinding IsDragging}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="RestFill" Value="{DynamicResource ScrollGripHover}"/></Trigger>
                                                                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="RestFill" Value="{DynamicResource ScrollGripHover}"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </app:LiquidScrollThumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Auto measurement briefly collapses its computed visibility while recycling rows.
                                             The committed range hides this overlay only when there is actually nothing to scroll. -->
                                        <Trigger Property="Maximum" Value="0"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Resources>
