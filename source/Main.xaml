                <Border><Grid>
                    <app:LiquidSheet x:Name="ListFrost" Backdrop="{Binding ElementName=Sky}" Film="{DynamicResource ListFilm}"/>
                    <app:ListCardBorder x:Name="ListRim" BorderThickness="0,1,0,0" Highlight="{DynamicResource CardHighlight}" CornerRadius="14"/>
                </Grid></Border>
            </app:GateGlassPanel>
