<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:AstralSplit;assembly=AstralSplit"
        Title="星云分流" Width="752" Height="733" MinWidth="560" MinHeight="555"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowFill}" Foreground="{DynamicResource Ink}"
        WindowStyle="None" ResizeMode="CanResize" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" xml:lang="zh-CN"
        FontSize="13" Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><app:ThemePalette/></ResourceDictionary.MergedDictionaries>
        <DropShadowEffect x:Key="MetadataShadow" Color="#0A0E18" Opacity=".87" ShadowDepth="0" BlurRadius="2.4" RenderingBias="Performance"/>
        <Style TargetType="TextBlock">
        </Style>
        <Style TargetType="Path">
        </Style>
        <Style x:Key="LineIcon" TargetType="Path" BasedOn="{StaticResource {x:Type Path}}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{DynamicResource Subtle}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Geometry x:Key="SortMemoryIcon">M2,3 H14 M2,8 H10 M2,13 H6</Geometry>
        <Geometry x:Key="SortWindowIcon">M1.5,2.5 H14.5 V13.5 H1.5 Z M2,6 H14 M5.5,6 V13</Geometry>
        <Style x:Key="KeyFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <app:KeyboardFocusRing BorderBrush="{DynamicResource FocusStroke}" BorderThickness="3"
                                               CornerRadius="10" Margin="-3" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchFocusRing" BasedOn="{StaticResource KeyFocusRing}">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <app:KeyboardFocusRing BorderBrush="{DynamicResource FocusStroke}" BorderThickness="3"
                                               CornerRadius="20" Margin="-3" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SortOption" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="OptionFace" CornerRadius="9" Background="Transparent" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                <app:LiquidLens x:Name="OptionGlass" Grid.ColumnSpan="2" Margin="-9,-7" Radius="9" SampleScene="True" Strength="0.57"
                                                Tint="{DynamicResource GlassTab}" Visibility="Collapsed"/>
                                <Path x:Name="CheckMark" Grid.Column="1" Width="13" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Data="M1,5 L4.5,8.5 L12,1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.65" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Hidden"/>
                                <Grid VerticalAlignment="Center">
                                    <ContentPresenter ContentSource="Header" CacheMode="{StaticResource ForegroundCache}" RecognizesAccessKey="True"/>
                                    <Border x:Name="NavigationLine" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                            Background="{TemplateBinding Foreground}" Visibility="Hidden" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionGlass" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="NavigationLine" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SortMenu" TargetType="ContextMenu">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SortOption}"/>
            <Setter Property="app:LiquidLens.GlassEnabled" Value="{DynamicResource GlassEnabled}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="10,3,10,17">
                            <Border Background="{DynamicResource GlassMenu}" CornerRadius="14">
                                <Border.Effect><DropShadowEffect Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.18"/></Border.Effect>
                            </Border>
                            <app:FrostedPane x:Name="MenuFrost" Backdrop="{Binding (app:LiquidLens.Scene),RelativeSource={RelativeSource TemplatedParent}}" Film="{DynamicResource MenuFilm}"/>
                            <Border CornerRadius="14" Padding="4" BorderBrush="{DynamicResource GlassSeam}" BorderThickness="1"
                                    app:LiquidLens.Scene="{Binding ElementName=MenuFrost}" app:LiquidLens.SceneCoat="{DynamicResource MenuFilm}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StarSortOption" TargetType="MenuItem">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="Transparent" Padding="9,6">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Path x:Name="SortSymbol" Style="{StaticResource LineIcon}" Data="{StaticResource SortWindowIcon}"
                                  HorizontalAlignment="Left" Stroke="{TemplateBinding Foreground}"/>
                            <Path x:Name="CheckMark" Width="13" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Stretch="Uniform" Data="M1,5 L4.5,8.5 L12,1" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.65" StrokeDashArray="16 16" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Hidden"/>
                            <Grid Grid.Row="1" HorizontalAlignment="Left" Margin="0,3,0,2">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.FontSize="13"/>
                                <Border x:Name="NavigationLine" Height="1" Margin="0,0,0,-1" VerticalAlignment="Bottom"
                                        Background="{TemplateBinding Foreground}" Visibility="Hidden" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Memory"><Setter TargetName="SortSymbol" Property="Data" Value="{StaticResource SortMemoryIcon}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="NavigationLine" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="StarSortMenu" TargetType="ContextMenu" BasedOn="{StaticResource SortMenu}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource StarSortOption}"/>
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="2" Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                        <Grid x:Name="SortMenuBody" Margin="10,3,10,17">
                        <Border Background="{DynamicResource GlassMenu}" CornerRadius="14">
                            <Border.Effect><DropShadowEffect Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.18"/></Border.Effect>
                        </Border>
                        <app:FrostedPane x:Name="MenuFrost" Backdrop="{Binding (app:LiquidLens.Scene),RelativeSource={RelativeSource TemplatedParent}}" Film="{DynamicResource MenuFilm}"/>
                        <Border CornerRadius="14" Padding="4" BorderBrush="{DynamicResource GlassSeam}" BorderThickness="1"
                                app:LiquidLens.Scene="{Binding ElementName=MenuFrost}">
                            <Grid x:Name="OrbitSurface">
                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid x:Name="MovingPlate" Margin="2,0" RenderTransformOrigin=".5,.5">
                                        <app:LiquidLens x:Name="SortGlass" Radius="9" Strength=".57" SampleScene="True" Tint="{DynamicResource GlassTab}"/>
                                        <Border x:Name="SortGlint" CornerRadius="9" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,.25">
                                                    <GradientStop Color="#00B0DDFF" Offset=".25"/><GradientStop Color="#49B0DDFF" Offset=".43"/>
                                                    <GradientStop Color="#B5F5FCFF" Offset=".50"/><GradientStop Color="#34D7BEFF" Offset=".58"/>
                                                    <GradientStop Color="#00D7BEFF" Offset=".76"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                <app:SortStarTrail x:Name="SortTrail" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="800"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <app:LiquidLens SampleScene="True" Tint="{TemplateBinding Background}" Pressed="{TemplateBinding IsPressed}"/>
                            <app:ButtonFeedback CornerRadius="16" Background="{DynamicResource ButtonInk}"
                                Hovered="{TemplateBinding IsMouseOver}" Pressed="{TemplateBinding IsPressed}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Background" Value="{DynamicResource GlassTool}"/>
        </Style>
        <Style x:Key="HeldGlassTool" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid x:Name="RestingSurface" IsHitTestVisible="False">
                            <app:LiquidLens SampleScene="True" Tint="{TemplateBinding Background}" Pressed="{TemplateBinding IsPressed}"/>
                            <app:ButtonFeedback CornerRadius="16" Background="{DynamicResource ButtonInk}"
                                Hovered="{TemplateBinding IsMouseOver}" Pressed="{TemplateBinding IsPressed}"/>
                        </Grid>
                        <app:HeldButtonGlass x:Name="HeldGlass" Pressed="{TemplateBinding IsPressed}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="ToolTipService.IsEnabled" Value="False"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="800"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                              UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Ellipse Fill="{DynamicResource CaptionInactive}" Stroke="{DynamicResource CaptionInactiveEdge}" StrokeThickness="0.5"/>
                            <Grid x:Name="CaptionPaint">
                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0.5"/>
                                <app:LiquidLens Radius="6" SampleScene="True" TintOpacity="0.87" Tint="{TemplateBinding Background}" Strength="0.86" Pressed="{TemplateBinding IsPressed}"/>
                            </Grid>
                            <Ellipse x:Name="CaptionEclipse" Opacity="0" Fill="#151419" Stroke="#F3D5A2" StrokeThickness="1.05"/>
                            <app:ButtonFeedback CornerRadius="6" Background="{DynamicResource CaptionPressed}" Pressed="{TemplateBinding IsPressed}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segment" TargetType="ToggleButton">
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeldGlassSegment" TargetType="ToggleButton" BasedOn="{StaticResource Segment}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <app:HeldButtonGlass x:Name="HeldGlass" Pressed="{TemplateBinding IsPressed}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="MainSwitch" TargetType="app:AnimatedSwitch">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource SwitchFocusRing}"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="AutomationProperties.HelpText" Value="点按切换，或长按滑块后左右拖动。滑块到端后轨道换色，松手确认，Esc 取消。"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="app:AnimatedSwitch">
                        <Grid x:Name="SwitchChrome" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="16" Background="{DynamicResource SwitchOff}"/>
                            <Border x:Name="TrackOutline" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource SwitchOutline}"
                                    IsHitTestVisible="False"/>
                            <Canvas IsHitTestVisible="False" UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Grid x:Name="Thumb" Margin="3,0,0,0">
                                    <app:CapsuleThumb x:Name="ThumbFace" Tint="{DynamicResource GlassKnob}" Strength="1.12" Pressed="{TemplateBinding IsPressed}"/>
                                    <Path x:Name="BusyGlyph" Data="M5,0 A5,5 0 1 1 0,5" RenderTransformOrigin="0.5,0.5"
                                          Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ThumbDiameter" Value="34"/>
            <Setter Property="ThumbWidth" Value="44"/>
            <Setter Property="OffBrush" Value="{DynamicResource SwitchOff}"/>
            <Setter Property="OnBrush" Value="{DynamicResource SwitchOn}"/>
        </Style>
        <Style TargetType="app:AnimatedSwitch" BasedOn="{StaticResource MainSwitch}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="ThumbDiameter" Value="24"/>
            <Setter Property="ThumbWidth" Value="34"/>
        </Style>
        <Style x:Key="AppListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <app:SortRowFace x:Name="SortRow" Background="Transparent" SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource AccentWash}" Margin="3,2" CornerRadius="8" IsHitTestVisible="False" Opacity="0"/>
                            <ContentPresenter/>
                        </app:SortRowFace>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AppRow">
            <app:AppRowSurface x:Name="RowFace" PendingRemoval="{Binding PendingRemoval}" ToolTip="{Binding Path}"
                               ToolTipService.InitialShowDelay="800" ClipToBounds="True" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>
                <app:RowHoverPlate Grid.ColumnSpan="5" Margin="4,2" CornerRadius="8" Background="{DynamicResource RowHover}"
                                   Hovered="{Binding IsMouseOver, ElementName=RowFace}" IsHitTestVisible="False"/>
                <app:BandwidthAdornment Width="48" Height="46" HorizontalAlignment="Left"/>
                <Grid x:Name="AppIconPlate" Width="32" Height="32" HorizontalAlignment="Left" Margin="8,0,0,0">
                    <Grid>
                        <Border CornerRadius="8" Background="{DynamicResource Recess}">
                            <Border.Style><Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                        </Border>
                        <Path Data="M2,3 H14 V11 H2 Z M5,14 H11 M8,11 V14" HorizontalAlignment="Center">
                            <Path.Style><Style TargetType="Path" BasedOn="{StaticResource LineIcon}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></Path.Style>
                        </Path>
                        <app:ApplicationIcon Source="{Binding Icon}" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="AppName" Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <Grid HorizontalAlignment="Left">
                        <app:TextHalo Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Description}" FontSize="{Binding FontSize, ElementName=AppDescription}"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MetadataHalo}"
                                   Effect="{StaticResource MetadataShadow}" Visibility="{DynamicResource MetadataHaloVisibility}"
                                   IsHitTestVisible="False" Focusable="False"/>
                        <TextBlock x:Name="AppDescription" Style="{StaticResource {x:Type TextBlock}}" Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
                <TextBlock x:Name="MemoryValue" Grid.Column="2" Text="{Binding MemoryLabel}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource ListValueInk}" FontSize="13" Typography.NumeralAlignment="Tabular"
                           ToolTip="占系统总内存的比例" ToolTipService.InitialShowDelay="800">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0">
                <app:RouteTag CacheMode="{StaticResource ForegroundCache}"
                              Routed="{Binding Selected}" Text="{Binding RouteLabel}" ActiveFill="{DynamicResource AccentWash}"
                              ActiveText="{DynamicResource AccentText}" IdleText="{DynamicResource ListValueInk}"/>
                <app:BandwidthAdornment TagPulse="True"/>
                </Grid>
                <app:AnimatedSwitch Grid.Column="4" IsChecked="{Binding Selected, Mode=OneWay}" HorizontalAlignment="Center"
                                    AutomationProperties.Name="{Binding ToggleLabel}"/>
                <Border x:Name="RowDivider" Grid.ColumnSpan="5" VerticalAlignment="Bottom" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Divider}" Margin="50,0,8,0" IsHitTestVisible="False"/>
            </app:AppRowSurface>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="False">
                    <Setter TargetName="AppIconPlate" Property="Opacity" Value="{DynamicResource IdleAppIconOpacity}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="AppName" Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPathQualifier}" Value="True">
                    <Setter TargetName="AppDescription" Property="Foreground" Value="{DynamicResource Subtle}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastVisible}" Value="True">
                    <Setter TargetName="RowDivider" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowSurface" RenderTransformOrigin="0.5,0.5" TextOptions.TextHintingMode="Animated" app:LiquidLens.GlassEnabled="{DynamicResource GlassEnabled}"
          TextOptions.TextRenderingMode="Grayscale">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource WindowFill}" IsHitTestVisible="False"/>
        <app:StarfieldLayer x:Name="Sky" Grid.RowSpan="2" IsHitTestVisible="False" Focusable="False" ClipToBounds="True"/>
        <Border x:Name="SkyInput" Grid.Row="1" Background="Transparent" Focusable="False"/>
        <Grid x:Name="ObservatoryCaption" Grid.Row="0" Background="Transparent" app:LiquidLens.Scene="{Binding ElementName=Sky}">
            <Grid x:Name="CaptionButtons" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
                  Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="20"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                <Button x:Name="HideToTray" Style="{StaticResource CaptionButton}" Background="{DynamicResource CaptionRed}" BorderBrush="{DynamicResource CaptionRedEdge}"
                        AutomationProperties.Name="最小化到托盘" ToolTip="最小化到托盘">
                    <Grid Width="10" Height="10">
                        <Path x:Name="CloseMoon" Fill="#D9FFFFFF" Data="M7.5,1.4 A4.1,4.1 0 1 0 8.6,7.5 A4.4,4.4 0 0 1 7.5,1.4 Z"/>
                        <Path x:Name="CloseMark" Stroke="{DynamicResource CaptionInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M3,3 L7,7 M7,3 L3,7" Opacity="0"/>
                    </Grid>
                </Button>
                <Button x:Name="Minimize" Grid.Column="1" Style="{StaticResource CaptionButton}" Background="{DynamicResource CaptionYellow}" BorderBrush="{DynamicResource CaptionYellowEdge}"
                        AutomationProperties.Name="最小化" ToolTip="最小化到任务栏">
                    <Grid Width="10" Height="10">
