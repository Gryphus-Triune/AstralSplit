                            </Grid>
                            <Grid x:Name="TelescopeArt" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed">
                                <Ellipse Width="48" Height="48" Fill="{DynamicResource AccentWash}"/>
                                <Path Fill="{DynamicResource SkySecondary}" Opacity=".8" Data="M8,13 l1,-3 1,3 3,1 -3,1 -1,3 -1,-3 -3,-1 Z M43,6 a1.4,1.4 0 1 0 .1,0 Z M49,24 a1,1 0 1 0 .1,0 Z"/>
                                <Path Stroke="{DynamicResource AccentText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M28,30 L20,46 M28,30 V44 M28,30 L38,46"/>
                                <Path x:Name="TelescopeTube" Fill="{DynamicResource AccentWash}" Stroke="{DynamicResource AccentText}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      Data="M12,32 L17,30 16,28 33,18 31,15 38,11 45,23 38,27 36,24 20,33 19,32 14,35 Z"/>
                            </Grid>
                            <TextBlock x:Name="Empty" Text="正在读取运行中的应用…" Foreground="{DynamicResource Ink}" FontSize="13"
                                       FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Subtle}" FontSize="12" Margin="0,4,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </app:ListCardBorder>
            </Grid>


        </Grid>
        <Border x:Name="ObservatoryInput" Grid.RowSpan="2" Panel.ZIndex="85" Background="Transparent" Visibility="Collapsed" Focusable="False"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="观测星空，单击点亮星星"/>
        <app:ObservatoryGlassButton x:Name="ObservatoryButton" Grid.Row="0" Panel.ZIndex="92" HorizontalAlignment="Right" VerticalAlignment="Center"
                Height="27" MinWidth="86" Margin="0,0,26,0" Padding="12,0" Style="{StaticResource GlassButton}"
                FocusVisualStyle="{StaticResource SwitchFocusRing}" Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
                app:LiquidLens.Scene="{Binding ElementName=Sky}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Content="星海观测" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                AutomationProperties.HelpText="使用此按钮进入或退出全屏观测，点击星空可以点亮星星"
                ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type app:ObservatoryGlassButton}">
                    <Grid Background="Transparent">
                        <Grid x:Name="RestingSurface" IsHitTestVisible="False">
                            <app:LiquidSheet Compact="True" Backdrop="{Binding (app:LiquidLens.Scene), RelativeSource={RelativeSource TemplatedParent}}" Film="{DynamicResource ListFilm}"/>
                            <app:ListCardBorder CornerRadius="8" BorderThickness="0,1,0,0" Highlight="{DynamicResource CardHighlight}"/>
                            <app:TextHalo Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#A00A0E18"
                                Effect="{StaticResource MetadataShadow}" Opacity="{DynamicResource DecorationOpacity}"/>
                        </Grid>
                        <Grid x:Name="RaisedSurface" Visibility="Hidden" Opacity="0" IsHitTestVisible="False">
                            <Border x:Name="Field" CornerRadius="14" Background="{DynamicResource SkyTrack}"/>
                            <Canvas UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <app:CapsuleThumb x:Name="Held" Tint="{DynamicResource GlassKnob}" RestFill="Transparent" Strength="1.12"/>
                            </Canvas>
                        </Grid>
                        <ContentPresenter x:Name="Legend" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="Medium" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </app:ObservatoryGlassButton>
        <Image x:Name="StellarInteraction" Grid.RowSpan="2" Panel.ZIndex="90" Stretch="Fill" IsHitTestVisible="False"/>
        <Canvas Grid.RowSpan="2" Panel.ZIndex="91" IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
            <Border x:Name="StarHoverCard" Visibility="Collapsed" Opacity="0" Padding="10,6" CornerRadius="8"
                    Background="{DynamicResource SkyScrim}" BorderBrush="{DynamicResource SkyEdge}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StarHoverName" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SkyText}"
                               TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="StarHoverStatus" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SkyBodyText}"/>
                </StackPanel>
            </Border>
        </Canvas>
        <Border x:Name="ConnectionCard" Visibility="Collapsed" Grid.Row="1" Panel.ZIndex="97"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="374" MaxHeight="410"
                Margin="18" Padding="16" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource SkyEdge}"
                Background="{DynamicResource GlassMenu}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <Button x:Name="CloseConnectionCard" DockPanel.Dock="Right" Style="{StaticResource PlainButton}"
                            Width="28" Height="28" Content="×" FontSize="17" AutomationProperties.Name="关闭连接详情"/>
                    <TextBlock x:Name="ConnectionCardTitle" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                </DockPanel>
                <TextBlock x:Name="ConnectionCardSummary" Grid.Row="1" Margin="0,6,0,10" Foreground="{DynamicResource AccentText}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <ScrollViewer Grid.Row="2" MaxHeight="234" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ConnectionCardBody" Foreground="{DynamicResource Ink}" FontSize="12" LineHeight="19" TextWrapping="Wrap"/>
                </ScrollViewer>
                <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button x:Name="CardPage" Content="下一页" Visibility="Collapsed" Padding="9,3" Margin="0,0,8,0" Style="{StaticResource PlainButton}"/>
                    <Button x:Name="CardTrial" Content="试用当前选择 60 秒" Padding="9,3" Style="{StaticResource PlainButton}"/>
                    <Button x:Name="CardExport" Content="检测公网出口" Padding="9,3" Style="{StaticResource PlainButton}" ToolTip="查看主动检测的范围和操作"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Image x:Name="ThemeGhost" Grid.RowSpan="2" Panel.ZIndex="99" Stretch="Fill"
               Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</Window>
